{
  "name": "@fengguanghuai/dsh-capability-hub",
  "version": "1.0.0",
  "description": "Codex-style unified capability hub for managing MCP servers, tools, skills, and switchable capability bundles in the top-left sidebar.",
  "license": "MIT",
  "author": "fengguanghuai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengguanghuai/dsh-capability-hub.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
